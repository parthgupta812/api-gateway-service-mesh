# Gateway
GATEWAY_PORT=8080

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend services (use Docker Compose service names, not localhost).
# Multiple instances of a service can be load-balanced by providing a
# comma-separated list of URLs.
USER_SERVICE_URL=http://user-service:9001
ORDER_SERVICE_URL=http://order-service-1:9002,http://order-service-2:9002,http://order-service-3:9002
PRODUCT_SERVICE_URL=http://product-service:9003

# Rate limiting (per client IP, backed by Redis)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Health-aware routing
HEALTH_CHECK_INTERVAL_SECONDS=5
HEALTH_CHECK_TIMEOUT_SECONDS=2
HEALTH_CHECK_PATH=/health

# Circuit breaker (per backend instance)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30

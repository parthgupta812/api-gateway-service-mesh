# Gateway
GATEWAY_PORT=8080

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend services (use Docker Compose service names, not localhost).
# Multiple instances of a service can be load-balanced by providing a
# comma-separated list of URLs.
USER_SERVICE_URL=http://user-service:9001
ORDER_SERVICE_URL=http://order-service-1:9002,http://order-service-2:9002,http://order-service-3:9002
PRODUCT_SERVICE_URL=http://product-service:9003

# Rate limiting (per client IP, backed by Redis)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Health-aware routing
HEALTH_CHECK_INTERVAL_SECONDS=5
HEALTH_CHECK_TIMEOUT_SECONDS=2
HEALTH_CHECK_PATH=/health

# Circuit breaker (per backend instance)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# PUBLIC DEPLOYMENT (e.g. Render free web services) — see README.md's
# "Public Deployment" section for full context. All variables above keep
# working exactly as-is; only their VALUES differ once real service URLs
# exist. Do not put real URLs here.
#
# USER_SERVICE_URL=https://<user-service>.onrender.com
# ORDER_SERVICE_URL=https://<order-1>.onrender.com,https://<order-2>.onrender.com,https://<order-3>.onrender.com
# PRODUCT_SERVICE_URL=https://<product-service>.onrender.com
# REDIS_HOST=<Render Key Value internal host>
# REDIS_PORT=<Render Key Value internal port>
#
# Cold-start tolerance: free Render web services spin down after 15
# minutes idle and take up to ~60s to wake on the next request. The
# existing HEALTH_CHECK_TIMEOUT_SECONDS / CIRCUIT_BREAKER_* variables
# above are what you tune for this -- no code changes are needed. Suggested
# starting values for a public deployment (adjust to taste, these are
# recommendations, not requirements):
#   HEALTH_CHECK_INTERVAL_SECONDS=15
#   HEALTH_CHECK_TIMEOUT_SECONDS=20
#   CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
#   CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30
# These are deliberately not extreme: long enough to survive one cold
# start, not so long that a genuinely broken instance is masked for
# minutes.
# ---------------------------------------------------------------------------
